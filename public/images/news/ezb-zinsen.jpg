<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <linearGradient id="bgEzb" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#064E3B" />
      <stop offset="100%" stop-color="#0F172A" />
    </linearGradient>
    <linearGradient id="chartLine" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#34D399" />
      <stop offset="100%" stop-color="#F59E0B" />
    </linearGradient>
  </defs>

  <rect width="800" height="450" fill="url(#bgEzb)" />

  <!-- Abstract Grid Lines -->
  <path d="M0 100 H800 M0 200 H800 M0 300 H800 M0 400 H800" stroke="#1E293B" stroke-width="1" stroke-dasharray="4 4" />

  <!-- Trend Curve -->
  <path d="M50 350 Q 200 320, 350 220 T 650 120 L 750 100" fill="none" stroke="url(#chartLine)" stroke-width="6" stroke-linecap="round" />
  <path d="M50 350 Q 200 320, 350 220 T 650 120 L 750 100 L 750 450 L 50 450 Z" fill="url(#chartLine)" opacity="0.15" />

  <!-- Glowing Data Nodes -->
  <circle cx="350" cy="220" r="10" fill="#34D399" stroke="#FFFFFF" stroke-width="3" />
  <circle cx="650" cy="120" r="12" fill="#F59E0B" stroke="#FFFFFF" stroke-width="4" />

  <!-- Title overlay graphics -->
  <rect x="50" y="50" width="180" height="36" rx="18" fill="#10B981" />
  <text x="140" y="73" font-family="sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF" text-anchor="middle">EZB LEITZINS 2026</text>

  <!-- Big rate callout -->
  <rect x="520" y="40" width="220" height="100" rx="12" fill="#065F46" stroke="#34D399" stroke-width="2" />
  <text x="630" y="80" font-family="sans-serif" font-size="28" font-weight="900" fill="#F59E0B" text-anchor="middle">bis zu 4,10%</text>
  <text x="630" y="110" font-family="sans-serif" font-size="12" font-weight="600" fill="#D1FAE5" text-anchor="middle">Garantierter Festgeldzins</text>
</svg>
